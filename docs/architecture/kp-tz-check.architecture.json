  "cards": [
    {
      "dot": "cyan",
      "title": "Основной pipeline",
      "items": [
        "Без LLM: load_incoming → audit → compliance; локальная и облачная LLM: run_pack через LangGraph.",
        "Tool registry задаёт JSON-схемы и единый invoke-контракт для нод."
      ]
    },
    {
      "dot": "cyan",
      "title": "Реализованные агенты",
      "items": [
        "Load/Structure — извлечение документов и подтверждение фактов; Pairing — связывание запросов и КП.",
        "Nomenclature — сопоставление позиций ТЗ и КП; Audit — проверка дат, товаров и полноты пакета.",
        "Compliance — применение методик и нормативных правил; Critic — анализ серой зоны и понижение статуса.",
        "HITL — фиксация решения специалиста; Reporting — формирование таблицы, HTML-отчёта и журнала."
      ]
    },
    {
      "dot": "emerald",
      "title": "Гарантии достоверности",
      "items": [
        "Дата регистрации КП берётся только из имени файла; остальные даты подтверждаются исходным текстом.",
        "Rule engine считает статусы; LLM не может повысить результат или подставить неподтверждённый факт."
      ]
    },
    {
      "dot": "violet",
      "title": "Сопоставление",
      "items": [
        "Запросы и КП связываются по исходящему номеру, поставщику и email.",
        "Позиции ТЗ и КП сравниваются по fingerprint, количеству, единицам и нечёткому сходству."
      ]
    },
    {
      "dot": "amber",
      "title": "Контроль и результаты",
      "items": [
        "Compliance применяет методички и расчёты; Critic обрабатывает только серую зону.",
        "Ручные решения разрешены для «Требует уточнения» и привязаны к fingerprint пакета."
      ]
    }
  ]
